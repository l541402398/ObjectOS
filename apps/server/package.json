{
  "name": "@projectos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProjectOS PostgreSQL organization control-plane server",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup --config ../../tooling/tsup.server.config.ts",
    "migrate": "tsx src/index.ts --migrate",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "@projectos/organization-contracts": "workspace:*",
    "better-auth": "^1.7.14",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
