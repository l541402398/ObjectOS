{
  "name": "@projectos/desktop",
  "version": "1.7.0",
  "private": true,
  "homepage": "https://github.com/l541402398/ObjectOS",
  "author": "ProjectOS contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "package:win": "electron-builder --win portable nsis --x64 --config electron-builder.yml --config.directories.output=../../release/win-x64",
    "package:win:x64": "electron-builder --win portable nsis --x64 --config electron-builder.yml --config.directories.output=../../release/win-x64",
    "package:win:ia32": "electron-builder --win portable nsis --ia32 --config electron-builder.yml --config.directories.output=../../release/win-ia32",
    "package:dir": "electron-builder --win dir --config electron-builder.yml"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "2.9.0",
    "@monaco-editor/react": "^4.7.0",
    "@projectos/ai-ui": "workspace:*",
    "@projectos/contracts": "workspace:*",
    "@projectos/design-tokens": "workspace:*",
    "@projectos/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.4",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.6",
    "dayjs": "^1.11.13",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.2",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.4"
  },
  "description": "ProjectOS local-first AI-native project lifecycle workspace",
  "license": "MIT"
}
