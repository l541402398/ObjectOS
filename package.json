{
  "name": "projectos",
  "version": "1.7.0",
  "private": true,
  "description": "ProjectOS — local-first AI-native project lifecycle workspace",
  "license": "MIT",
  "homepage": "https://github.com/l541402398/ObjectOS",
  "author": {
    "name": "ProjectOS contributors",
    "email": "l541402398@users.noreply.github.com"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "predev": "pnpm build:runtime",
    "dev": "cross-env ELECTRON_RUN_AS_NODE= concurrently -k -n runtime,desktop -c blue,magenta \"tsup --config tooling/tsup.runtime.config.ts --watch\" \"pnpm --filter @projectos/desktop dev\"",
    "dev:desktop": "cross-env ELECTRON_RUN_AS_NODE= pnpm --filter @projectos/desktop dev",
    "dev:runtime": "tsup --config tooling/tsup.runtime.config.ts --watch",
    "build": "pnpm build:runtime && pnpm build:desktop",
    "build:runtime": "tsup --config tooling/tsup.runtime.config.ts",
    "build:desktop": "pnpm --filter @projectos/desktop build",
    "start": "cross-env ELECTRON_RUN_AS_NODE= pnpm --filter @projectos/desktop start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && node scripts/e2e.mjs",
    "screenshots": "pnpm build && node scripts/screenshots.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:agent": "pnpm build && node scripts/agent-e2e.mjs",
    "test:command": "pnpm build && node scripts/command-e2e.mjs",
    "package:win": "pnpm build && pnpm --filter @projectos/desktop package:win:x64 && pnpm --filter @projectos/desktop package:win:ia32 && node scripts/collect-win-artifacts.mjs",
    "package:linux": "bash scripts/package-linux.sh",
    "package:dir": "pnpm build && pnpm --filter @projectos/desktop package:dir",
    "test:package": "node scripts/package-smoke.mjs",
    "test:v12": "pnpm build && node scripts/v12-e2e.mjs",
    "test:v13": "pnpm build && node scripts/v13-e2e.mjs",
    "test:orchestration": "pnpm build && node scripts/v13-orchestration-e2e.mjs",
    "test:teamwork": "pnpm build && node scripts/v18-teamwork-e2e.mjs",
    "test:r1a": "node scripts/r1a-cross-process.mjs",
    "test:r1b": "pnpm build:runtime && node scripts/r1b-kill-restart-e2e.mjs",
    "test:r1": "pnpm test -- tests/r1-concurrency.test.ts tests/r1-budgets.test.ts tests/r1-handoff-reassign.test.ts && pnpm test:r1a && pnpm test:r1b",
    "test:r2-ui": "pnpm build && node scripts/r2-reassign-ui-e2e.mjs",
    "test:r2-package-migration": "node scripts/r2-package-migration.mjs",
    "test:r2-package-features": "node scripts/r2-package-features.mjs",
    "test:r2": "pnpm test -- tests/r2-phase1.test.ts tests/r2-quality-evidence-reconcile.test.ts tests/r2-revision-inbox-legacy.test.ts tests/r2-file-attribution.test.ts && pnpm test:r2-ui",
    "test:r21-ui": "node scripts/r21-ui-regression.mjs",
    "test:r21": "pnpm test -- tests/r2-human-acceptance.test.ts && pnpm test:r21-ui",
    "package:win:x64": "pnpm build && pnpm --filter @projectos/desktop package:win:x64 && node scripts/collect-win-artifacts.mjs",
    "package:win:ia32": "pnpm build && pnpm --filter @projectos/desktop package:win:ia32 && node scripts/collect-win-artifacts.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "43.8.2",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
